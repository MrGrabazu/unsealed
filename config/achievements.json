{
  "metrics": {
    "boosters_opened": { "event": "BoosterOpened", "op": "sum" },
    "value_opened_cents": { "event": "BoosterOpened", "op": "sum", "field": "valueCents" },
    "cards_sold": { "event": "CardSold", "op": "sum", "field": "quantity" },
    "sets_opened": { "event": "BoosterOpened", "op": "distinct", "field": "setCode" },
    "sets_completed": {
      "event": "SetProgress",
      "where": [{ "field": "completionPermille", "op": "gte", "value": 1000 }],
      "op": "distinct",
      "field": "setCode"
    },
    "no_mythic_streak": {
      "event": "BoosterOpened",
      "op": "streak",
      "resetWhen": [{ "field": "mythicCount", "op": "gt", "value": 0 }]
    },
    "no_new_card_streak": {
      "event": "BoosterOpened",
      "op": "streak",
      "resetWhen": [{ "field": "newCardCount", "op": "gt", "value": 0 }]
    },
    "years_completed": {
      "event": "YearProgress",
      "where": [{ "field": "complete", "op": "eq", "value": true }, { "field": "setCount", "op": "gte", "value": 2 }],
      "op": "distinct",
      "field": "year"
    },
    "best_balance_cents": { "event": "BalanceChanged", "op": "max", "field": "balanceCents" },
    "achievements_unlocked": { "event": "AchievementUnlocked", "op": "sum" }
  },

