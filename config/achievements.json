{
  "metrics": {
    "boosters_opened": { "event": "BoosterOpened", "op": "sum" },
    "value_opened_cents": { "event": "BoosterOpened", "op": "sum", "field": "valueCents" },
    "cards_sold": { "event": "CardSold", "op": "sum", "field": "quantity" },
    "sets_opened": { "event": "BoosterOpened", "op": "distinct", "field": "setCode" },
    "sets_completed": {
      "event": "SetProgress",
      "where": [{ "field": "completionPermille", "op": "gte", "value": 1000 }],
      "op": "distinct",
      "field": "setCode"
    },
    "no_mythic_streak": {
      "event": "BoosterOpened",
      "op": "streak",
      "resetWhen": [{ "field": "mythicCount", "op": "gt", "value": 0 }]
    },
    "no_new_card_streak": {
      "event": "BoosterOpened",
      "op": "streak",
      "resetWhen": [{ "field": "newCardCount", "op": "gt", "value": 0 }]
    },
    "years_completed": {
      "event": "YearProgress",
      "where": [{ "field": "complete", "op": "eq", "value": true }, { "field": "setCount", "op": "gte", "value": 2 }],
      "op": "distinct",
      "field": "year"
    },
    "best_balance_cents": { "event": "BalanceChanged", "op": "max", "field": "balanceCents" },
    "achievements_unlocked": { "event": "AchievementUnlocked", "op": "sum" },
    "cards_discovered": { "event": "CardAcquired", "op": "distinct", "field": "uuid" },
    "foils_pulled": { "event": "CardAcquired", "where": [{ "field": "foil", "op": "eq", "value": true }], "op": "sum" },
    "mythics_pulled": { "event": "CardAcquired", "where": [{ "field": "rarity", "op": "eq", "value": "mythic" }], "op": "sum" },
    "mythic_kinds": {
      "event": "CardAcquired",
      "where": [{ "field": "rarity", "op": "eq", "value": "mythic" }],
      "op": "distinct",
      "field": "uuid"
    },
    "tokens_pulled": { "event": "CardAcquired", "where": [{ "field": "rarity", "op": "eq", "value": "token" }], "op": "sum" },
    "boosters_bought": { "event": "BoosterBought", "op": "sum", "field": "quantity" },
    "charity_claims": { "event": "CharityClaimed", "op": "sum" },
    "income_cents": { "event": "IncomeEarned", "op": "sum", "field": "amountCents" },
    "token_kinds": {
      "event": "CardAcquired",
      "where": [{ "field": "rarity", "op": "eq", "value": "token" }],
      "op": "distinct",
      "field": "uuid"
    },
    "art_kinds": {
      "event": "CardAcquired",
      "where": [{ "field": "rarity", "op": "eq", "value": "art" }],
      "op": "distinct",
      "field": "uuid"
    },
    "signed_arts_pulled": {
      "event": "CardAcquired",
      "where": [{ "field": "rarity", "op": "eq", "value": "art" }, { "field": "foil", "op": "eq", "value": true }],
      "op": "sum"
    },
    "boosters_watched": { "event": "BoosterOpened", "where": [{ "field": "animated", "op": "eq", "value": true }], "op": "sum" },
    "boosters_rushed": { "event": "BoosterOpened", "where": [{ "field": "animated", "op": "eq", "value": false }], "op": "sum" }
  },

